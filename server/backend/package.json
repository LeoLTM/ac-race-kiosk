{
	"name": "@racekiosk/backend",
	"version": "0.1.0",
	"description": "The backend for the Assetto Corsa race kiosk control server.",
	"private": true,
	"scripts": {
		"dev": "bun --watch src/index.ts",
		"build": "tsup",
		"start": "node dist/index.js",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc",
		"postinstall": "prisma generate",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio",
		"db:seed": "bun prisma/scripts/seed.ts"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "7.3.4",
		"@prisma/adapter-libsql": "^7.0.1",
		"@prisma/client": "^7.0.1",
		"cors": "2.8.5",
		"dotenv": "17.2.1",
		"express": "5.1.0",
		"express-rate-limit": "8.0.1",
		"helmet": "8.1.0",
		"http-status-codes": "2.3.0",
		"pino": "9.9.0",
		"pino-http": "10.5.0",
		"socket.io": "^4.8.1",
		"swagger-ui-express": "5.0.1",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@racekiosk/shared": "workspace:*",
		"@types/cors": "2.8.19",
		"@types/express": "5.0.3",
		"@types/node": "^22.10.2",
		"@types/supertest": "6.0.3",
		"@types/swagger-ui-express": "4.1.8",
		"@vitest/coverage-v8": "3.2.4",
		"pino-pretty": "13.1.1",
		"prisma": "^7.0.1",
		"supertest": "7.1.4",
		"tsup": "8.5.0",
		"vite-tsconfig-paths": "5.1.4",
		"vitest": "3.2.4"
	}
}

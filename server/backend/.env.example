# Environment Configuration
NODE_ENV="development" # Options: 'development', 'production'
PORT="8080"            # The port your server will listen on
HOST="localhost"       # Hostname for the server

# CORS Settings
CORS_ORIGIN="*" # Allowed CORS origin, adjust as necessary

# Rate Limiting
COMMON_RATE_LIMIT_WINDOW_MS="1000"  # Window size for rate limiting (ms)
COMMON_RATE_LIMIT_MAX_REQUESTS="20" # Max number of requests per window per IP

# Race Kiosk Configuration
NUMBER_OF_RIGS="3"          # Number of rigs the server will manage (ids 1..N, must match rig_id in each AC app's settings.ini)
SESSION_DURATION_MIN="10"   # Length of one driving session; hard stop when it runs out
CALL_TIMEOUT_SEC="120"      # Time a called player has to press Start before counting as a no-show
SKIP_REQUEUE_POSITIONS="3"  # Places a skipped player moves back (second skip drops them); 0 = drop immediately
RIG_OFFLINE_AFTER_SEC="10"  # Rig counts as offline without an AC app heartbeat for this long
KIOSK_KEY=""                # Shared secret for rig apps + staff admin page (X-Kiosk-Key header); empty = no check

# Database (default: prisma/dev.db in dev, racekiosk.db next to the packaged executable)
# DATABASE_URL="file:./prisma/dev.db"

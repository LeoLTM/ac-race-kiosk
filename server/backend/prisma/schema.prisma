// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A person who registered at the kiosk. Names are unique case-insensitively (nameKey),
// so a returning visitor using the same name keeps their personal bests.
model Driver {
  id        String   @id @default(cuid())
  name      String
  nameKey   String   @unique
  createdAt DateTime @default(now())

  queueEntries QueueEntry[]
  sessions     Session[]
  laps         Lap[]
}

// A racing rig running the racekiosk AC app. Rows 1..NUMBER_OF_RIGS are created on boot;
// track/car/appVersion are reported by the app's heartbeat.
model Rig {
  id          Int       @id
  enabled     Boolean   @default(true)
  lastSeenAt  DateTime?
  appVersion  String?
  track       String?
  trackConfig String?
  car         String?

  queueEntries QueueEntry[]
  sessions     Session[]
  laps         Lap[]
}

// One registration in the shared queue.
// status: WAITING -> CALLED (rigId set) -> STARTED, or REMOVED / NO_SHOW
model QueueEntry {
  id        String    @id @default(cuid())
  driverId  String
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  status    String    @default("WAITING")
  // Queue order; a float so entries can be moved between neighbours without renumbering
  sortKey   Float
  skipCount Int       @default(0)
  rigId     Int?
  rig       Rig?      @relation(fields: [rigId], references: [id])
  calledAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  session Session?

  @@index([status, sortKey])
}

// One driver's stint on a rig. Active while endedAt is null; hard-stopped at endsAt.
// endReason: TIME_UP | DRIVER | STAFF
model Session {
  id           String      @id @default(cuid())
  rigId        Int
  rig          Rig         @relation(fields: [rigId], references: [id])
  driverId     String
  driver       Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  queueEntryId String?     @unique
  queueEntry   QueueEntry? @relation(fields: [queueEntryId], references: [id], onDelete: SetNull)
  startedAt    DateTime    @default(now())
  endsAt       DateTime
  endedAt      DateTime?
  endReason    String?
  track        String?
  trackConfig  String?
  car          String?

  laps Lap[]

  @@index([rigId, endedAt])
}

// Every lap reported by a rig app. Only valid laps count for the leaderboard.
// invalidReason: CUT | PIT | OUT_LAP | TOO_SHORT | AFTER_TIME | STAFF
model Lap {
  id            String   @id @default(cuid())
  // Generated by the AC app; makes re-sent laps (after network errors) idempotent
  clientLapId   String   @unique
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  driverId      String
  driver        Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  rigId         Int
  rig           Rig      @relation(fields: [rigId], references: [id])
  lapTimeMs     Int
  valid         Boolean
  invalidReason String?
  // JSON array of sector times in ms, if the rig reported them
  sectorsMs     String?
  track         String
  trackConfig   String   @default("")
  car           String
  completedAt   DateTime
  createdAt     DateTime @default(now())

  @@index([track, trackConfig, car, valid, lapTimeMs])
  @@index([sessionId])
}

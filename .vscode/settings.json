{
	// The Bun workspace (and its Biome config + binary) lives in server/, not at the repo root
	"biome.configurationPath": "server/biome.json",
	"biome.lsp.bin": "server/node_modules/@biomejs/biome/bin/biome",
	"[javascript][typescript][typescriptreact][json][jsonc][css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"editor.codeActionsOnSave": {
		"source.organizeImports.biome": "explicit"
	},

	// Generated by the TanStack Router plugin
	"files.readonlyInclude": { "**/routeTree.gen.ts": true },
	"files.watcherExclude": { "**/routeTree.gen.ts": true },
	"search.exclude": { "**/routeTree.gen.ts": true }
}
